{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com"
      ]
    },
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "git ls-remote *"
    ]
  }
}
